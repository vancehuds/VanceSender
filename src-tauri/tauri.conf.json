{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "VanceSender",
  "version": "0.1.0",
  "identifier": "com.vancesender.app",
  "build": {
    "devUrl": "http://localhost:8730",
    "frontendDist": "../app/web"
  },
  "app": {
    "windows": [
      {
        "title": "VanceSender",
        "width": 1280,
        "height": 860,
        "minWidth": 1080,
        "minHeight": 700,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "dragDropEnabled": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.ico",
      "iconAsTemplate": false,
      "tooltip": "VanceSender"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": [
      "sidecar/vancesender-server"
    ],
    "resources": {
      "sidecar/*": "./"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": true
      }
    }
  },
  "plugins": {
    "shell": {
      "sidecar": true,
      "scope": [
        {
          "name": "sidecar/vancesender-server",
          "sidecar": true,
          "args": true
        }
      ]
    }
  }
}
